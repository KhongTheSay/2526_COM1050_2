<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Biến định nghĩa thư mục lưu log -->
    <property name="LOG_DIR" value="logs" />

    <!-- 1. Appender hiển thị ra Console (Màn hình terminal) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Định dạng: Thời gian [Luồng] Cấp độ Tên_Class - Thông điệp -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. Appender lưu vào file (Để lưu trữ lâu dài) -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/bank_system.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Cấu hình mức log mặc định là INFO cho toàn bộ project -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

</configuration>